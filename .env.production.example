# Public URL used by browsers. Do not add a trailing slash.
APP_PUBLIC_URL=https://inventory.example.com
APP_DOMAIN=inventory.example.com

# Caddy publishes HTTP/HTTPS and redirects port 80 to HTTPS automatically.
HTTPS_BIND_ADDRESS=0.0.0.0

DB_NAME=invault
DB_USERNAME=invault
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-an-independent-root-password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# Required only for the private, non-TLS MySQL service in compose.prod.yml.
# Leave false for external databases and keep DB_SSL_MODE=REQUIRED there.
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# Base64 encoding of at least 32 cryptographically random bytes.
INVAULT_JWT_SECRET=replace-with-a-base64-secret
INVAULT_JWT_ISSUER=https://inventory.example.com
INVAULT_JWT_EXPIRATION=30m

# Enable only for the first deployment, then set back to false.
INVAULT_BOOTSTRAP_ADMIN_ENABLED=true
INVAULT_BOOTSTRAP_ADMIN_USERNAME=admin
INVAULT_BOOTSTRAP_ADMIN_EMAIL=admin@inventory.example.com
INVAULT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-admin-password
